#!/usr/bin/env python3
"""RAW endpoint: download a plain SQL dump of one of the user's own DBs.

Full HTTP response is controlled here (headers + streamed pg_dump body).
Never reads stdin. DB membership is verified before streaming.
"""
import os
import subprocess
import sys
sys.path.insert(0, "/usr/local/directadmin/plugins/postgres_manager/scripts")
try:
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "scripts"))
except Exception:
    pass
from ui_lib import get_da_user, parse_params, helper_call, parse_list_output

PLUGIN_DIR = "/usr/local/directadmin/plugins/postgres_manager"
HELPER = os.path.join(PLUGIN_DIR, "scripts", "pg_helper.sh")


def raw(status, ctype, body=b"", filename=None):
    out = sys.stdout.buffer
    out.write(f"HTTP/1.1 {status}\r\n".encode())
    out.write(f"Content-Type: {ctype}\r\n".encode())
    if filename:
        out.write(f'Content-Disposition: attachment; filename="{filename}"\r\n'.encode())
    out.write(b"Connection: close\r\n\r\n")
    if body:
        out.write(body if isinstance(body, bytes) else body.encode())
    out.flush()


def main():
    user = get_da_user()
    db = (parse_params().get("db") or "").strip().lower()
    rc, out, err = helper_call("list", user)
    names = []
    if rc == 0:
        names = [d["name"] for d in parse_list_output(out)["dbs"]]
    if not db or db not in names:
        raw("404 Not Found", "text/plain", b"Unknown database.\n")
        return
    safe = "".join(c if (c.isalnum() or c in "._-") else "_" for c in f"{db}.sql")
    raw("200 OK", "application/sql", filename=safe)
    # stream pg_dump straight to the client (helper validates again)
    try:
        subprocess.run(["sudo", "-n", "-u", "postgres", HELPER,
                        "dump", "--user", user, "--db", db],
                       timeout=570)
    except Exception:
        pass


try:
    main()
except Exception as ex:
    try:
        raw("500 Internal Error", "text/plain", f"failed: {ex}\n")
    except Exception:
        pass
