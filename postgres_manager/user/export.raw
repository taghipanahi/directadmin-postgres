#!/usr/bin/env python3
"""RAW endpoint: download one table as CSV (HEADER true).

Streams COPY output; strips the single SET ROLE prelude echo line.
"""
import os
import subprocess
import sys
sys.path.insert(0, "/usr/local/directadmin/plugins/postgres_manager/scripts")
try:
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "scripts"))
except Exception:
    pass
from ui_lib import get_da_user, parse_params, helper_call, parse_list_output

PLUGIN_DIR = "/usr/local/directadmin/plugins/postgres_manager"
HELPER = os.path.join(PLUGIN_DIR, "scripts", "pg_helper.sh")


def raw(status, ctype, body=b"", filename=None):
    out = sys.stdout.buffer
    out.write(f"HTTP/1.1 {status}\r\n".encode())
    out.write(f"Content-Type: {ctype}\r\n".encode())
    if filename:
        safe = "".join(c if (c.isalnum() or c in "._-") else "_" for c in filename)
        out.write(f'Content-Disposition: attachment; filename="{safe}"\r\n'.encode())
    out.write(b"Connection: close\r\n\r\n")
    if body:
        out.write(body if isinstance(body, bytes) else body.encode())
    out.flush()


def main():
    user = get_da_user()
    p = parse_params()
    db = (p.get("db") or "").strip().lower()
    tbl = (p.get("tbl") or "").strip().lower()
    rc, out, err = helper_call("list", user)
    names = []
    if rc == 0:
        names = [d["name"] for d in parse_list_output(out)["dbs"]]
    if not db or db not in names:
        raw("404 Not Found", "text/plain", b"Unknown database.\n")
        return
    rc, out, err = helper_call("tables", user, db=db)
    tnames = []
    if rc == 0:
        for line in out.splitlines():
            line = line.strip()
            if line == "---TABLES---" or not line:
                continue
            parts = line.split("|")
            if parts:
                tnames.append(parts[0])
    if not tbl or tbl not in tnames:
        raw("404 Not Found", "text/plain", b"Unknown table.\n")
        return
    fname = f"{db}.{tbl}.csv"
    # headers first, then stream; drop the SET ROLE prelude echo line
    out = sys.stdout.buffer
    out.write(b"HTTP/1.1 200 OK\r\nContent-Type: text/csv\r\n")
    safe = "".join(c if (c.isalnum() or c in "._-") else "_" for c in fname)
    out.write(f'Content-Disposition: attachment; filename="{safe}"\r\n'.encode())
    out.write(b"Connection: close\r\n\r\n")
    out.flush()
    try:
        pr = subprocess.Popen(["sudo", "-n", "-u", "postgres", HELPER,
                               "export-csv", "--user", user,
                               "--db", db, "--tbl", tbl],
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        first = True
        try:
            for chunk in iter(lambda: pr.stdout.read(65536), b""):
                if not chunk:
                    break
                if first:
                    if chunk.startswith(b"SET ROLE\n"):
                        chunk = chunk[len(b"SET ROLE\n"):]
                    elif chunk.startswith(b"SET ROLE\r\n"):
                        chunk = chunk[len(b"SET ROLE\r\n"):]
                    first = False
                    if not chunk:
                        continue
                out.write(chunk)
            out.flush()
        finally:
            try:
                pr.wait(timeout=540)
            except Exception:
                try:
                    pr.kill()
                except Exception:
                    pass
    except Exception:
        pass


try:
    main()
except Exception as ex:
    try:
        raw("500 Internal Error", "text/plain", f"failed: {ex}\n")
    except Exception:
        pass
